# MonkChat Guide — Supabase Environment Variables
#
# Copy this file to .env.local and fill in your Supabase project values.
# .env.local is excluded from version control by .gitignore.
#
# Do NOT put real values in this .env.example file.
# Do NOT use the service-role key or any server-side secret here.
# VITE_SUPABASE_PUBLISHABLE_KEY is the anon/public key from your Supabase project dashboard.

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
